--- !u!114 &350046848
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 350046846}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Author: Commander Elias Ward.

    Timestamp: Sol 19.


    I saw someone
    outside on the ridge today.


    At first I thought it was a trick of the visor.
    Maybe light scattering across the dust. But the shape held together. Tall. Upright.
    Standing perfectly still on the horizon.


    No suit transponder. No shuttle
    signatures. No scheduled arrivals.


    When I turned to retrieve the binoculars,
    it was gone.


    I reviewed the external cameras afterward. Empty terrain.
    Nothing unusual.


    I''m logging this as a visual misinterpretation caused
    by fatigue and isolation. That''s the rational explanation.


    But I can''t
    shake the feeling that it was looking directly at me.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
  m_sharedMaterial: {fileID: 2140032, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
